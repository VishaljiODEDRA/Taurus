# eToro public API credentials.
# Create separate Demo and Real keys in eToro. Keep write keys scoped to an Agent Portfolio.
ETORO_API_KEY=
ETORO_USER_KEY=
ETORO_BASE_URL=https://public-api.etoro.com/api/v1
ETORO_USER_AGENT=AutoTrading-Agent/0.1 (+https://api-portal.etoro.com/)

# Optional OpenAI context analyzer. The LLM is used for news/context summaries only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Runtime guard. Keep false unless you are deliberately enabling real-money order submission.
AUTOTRADER_ALLOW_LIVE=false
